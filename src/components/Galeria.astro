---
import { site, waLink } from '../data/site';

/*
  GALERÍA DE TRABAJOS RECIENTES
  ==============================
  - Desktop: Scroll horizontal anclado (pin) con GSAP ScrollTrigger.
    El contenedor [data-gallery] se fija mientras el usuario hace scroll vertical.
  - Móvil / reduced-motion: Fallback a scroll horizontal nativo con CSS scroll-snap.

  PARA AGREGAR FOTOS REALES:
  1. Copia tus imágenes a `src/assets/galeria/` (ej: trabajo-01.jpg, trabajo-02.jpg…)
  2. Importa cada imagen con `import { Image } from 'astro:assets'` y reemplaza
     el bloque de placeholder por `<Image src={trabajoImg} alt="..." ... />`
  3. Elimina los bloques class="gallery-placeholder" y los estilos de gradiente.
*/

const trabajos = [
  { id: 1, etiqueta: "Afinación mayor", color: "from-blue/30 to-surface-2" },
  { id: 2, etiqueta: "Cambio de frenos", color: "from-red/20 to-surface-2" },
  { id: 3, etiqueta: "Diagnóstico ECU", color: "from-gold/20 to-surface-2" },
  { id: 4, etiqueta: "Suspensión deportiva", color: "from-blue/20 to-surface-2" },
  { id: 5, etiqueta: "Alineación y balanceo", color: "from-red/15 to-surface-2" },
  { id: 6, etiqueta: "Performance / Tuning", color: "from-gold/15 to-surface-2" },
];
---

<section id="trabajos" class="bg-bg py-20 overflow-hidden">

  <!-- Encabezado (fuera del área de pin para no verse afectado) -->
  <div class="px-4 sm:px-6 lg:px-8 mb-10">
    <div class="mx-auto max-w-7xl">
      <p class="mb-2 font-heading text-xs font-semibold uppercase tracking-[0.25em] text-red">
        Prueba social
      </p>
      <h2 class="font-heading text-3xl font-bold uppercase text-text sm:text-4xl">
        Trabajos Recientes
      </h2>
      <p class="mt-4 text-text-dim max-w-xl">
        Cada auto que entra al taller sale en perfectas condiciones. Aquí algunos de nuestros trabajos.
      </p>
    </div>
  </div>

  <!-- Contenedor de galería con scroll horizontal en móvil -->
  <!-- En desktop, GSAP crea un pin horizontal; en móvil/reduced-motion = scroll-snap CSS -->
  <div data-gallery-wrapper class="relative">
    <div
      data-gallery
      class="gallery-scroll flex gap-4 px-4 pb-4 sm:px-6 lg:px-8"
      style="will-change: transform;"
    >
      {trabajos.map((t) => (
        <article
          class:list={[
            "gallery-card group relative shrink-0 rounded-xl overflow-hidden border border-white/10",
            "w-72 sm:w-80 lg:w-96 aspect-4/3",
            `bg-linear-to-br ${t.color}`,
          ]}
        >
          <!-- Placeholder visual (reemplazar con <Image> cuando haya fotos reales) -->
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6">
            <div class="rounded-full border border-white/20 p-4 bg-white/5">
              <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-silver)" stroke-width="1.5">
                <path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="text-center">
              <p class="text-xs text-text-dim uppercase tracking-widest font-heading">Próximamente</p>
              <p class="text-sm font-semibold text-silver mt-1">{t.etiqueta}</p>
              <p class="text-xs text-text-dim mt-1">Foto de trabajo real</p>
            </div>
          </div>

          <!-- Overlay inferior con etiqueta -->
          <div class="absolute bottom-0 inset-x-0 p-4"
               style="background: linear-gradient(to top, rgba(10,11,13,0.9), transparent);">
            <span class="font-heading text-sm font-semibold uppercase text-text">
              {t.etiqueta}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- CTA inferior -->
  <div class="mt-10 text-center px-4">
    <p class="text-text-dim text-sm mb-4">
      ¿Quieres ser el próximo testimonio? Agenda tu cita hoy.
    </p>
    <a
      href={waLink("Hola ZIT'DCA RS, quiero agendar un servicio.")}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-whatsapp px-6 py-3 font-bold text-white transition-transform hover:scale-105 active:scale-95"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Agendar ahora
    </a>
  </div>

</section>

<style>
  /* Scroll horizontal nativo como fallback para móvil y reduced-motion */
  .gallery-scroll {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }
  .gallery-scroll::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }
  .gallery-card {
    scroll-snap-align: start;
  }

  /* En desktop el JS sobreescribe overflow con pin horizontal */
  @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
    .gallery-scroll {
      /* GSAP tomará el control; dejar overflow visible para el pin */
      overflow: visible;
    }
  }
</style>
