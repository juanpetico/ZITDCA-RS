---
import { waLink, trabajos, categoriasTrabajo } from '../data';

/*
  GALERÍA DE TRABAJOS RECIENTES — Grilla bento + filtros + comparador antes/después
  =================================================================================
  - Layout: grilla responsive (2 col móvil → 3 col desktop), reveal escalonado GSAP.
  - Filtros: chips por categoría + toggle "Solo antes/después". Filtrado en JS vanilla
    (sin frameworks) mostrando/ocultando por [data-categoria] / [data-tiene-antes].
  - Tarjeta con `antes` y `despues` → comparador con divisor arrastrable.
  - Tarjeta solo con `despues` (o sin foto) → imagen/placeholder con badge "Resultado".

  PARA FOTOS REALES: ver instrucciones en `src/data/trabajos.ts`.
*/

// Iconos SVG reutilizados en placeholders
const camIcon =
  "M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z";
---

<section id="trabajos" class="bg-bg py-20">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">

      <!-- Encabezado -->
      <p class="mb-2 font-heading text-xs font-semibold uppercase tracking-[0.25em] text-red">
        Prueba social
      </p>
      <h2 class="font-heading text-3xl font-bold uppercase text-text sm:text-4xl">
        Trabajos Recientes
      </h2>
      <p class="mt-4 max-w-xl text-text-dim">
        Cada auto que entra al taller sale en perfectas condiciones. Arrastra el divisor para ver el antes y el después.
      </p>

      <!-- Filtros -->
      <div class="mt-8 flex flex-wrap items-center gap-2" data-galeria-filtros>
        {categoriasTrabajo.map((cat, i) => (
          <button
            type="button"
            data-filtro={cat.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class:list={[
              'galeria-chip rounded-full px-4 py-1.5 font-heading text-sm font-semibold uppercase tracking-wide transition-colors',
              i === 0
                ? 'bg-blue text-white'
                : 'border border-white/15 text-text-dim hover:border-blue/60 hover:text-text',
            ]}
          >
            {cat.label}
          </button>
        ))}

        <!-- Toggle: solo antes/después -->
        <label class="ml-auto flex cursor-pointer select-none items-center gap-2 text-sm text-text-dim">
          <input type="checkbox" data-solo-antes class="peer sr-only" />
          <span
            class="relative h-5 w-9 rounded-full bg-white/15 transition-colors peer-checked:bg-blue after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-4"
          ></span>
          Solo antes/después
        </label>
      </div>

      <!-- Grilla bento -->
      <div
        data-galeria-grid
        class="mt-8 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3"
      >
        {trabajos.map((t) => {
          const tieneAntes = Boolean(t.antes && t.despues);
          return (
            <article
              data-anim="card"
              data-categoria={t.categoria}
              data-tiene-antes={tieneAntes ? 'true' : 'false'}
              class="galeria-card group relative aspect-4/3 overflow-hidden rounded-xl border border-white/10 bg-surface-2 transition-shadow hover:shadow-[0_0_24px_-6px_var(--color-blue)]"
            >
              {tieneAntes ? (
                /* ── Comparador antes/después ── */
                <div class="comparador absolute inset-0" data-comparador style="--pos:50%;">
                  <!-- Base: DESPUÉS (lado izquierdo) -->
                  <img
                    src={t.despues}
                    alt={t.despuesAlt ?? `${t.etiqueta} — después`}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover select-none"
                    draggable="false"
                  />
                  <!-- Overlay: ANTES (lado derecho, recortado por --pos) -->
                  <img
                    src={t.antes}
                    alt={t.antesAlt ?? `${t.etiqueta} — antes`}
                    loading="lazy"
                    decoding="async"
                    class="cmp-antes absolute inset-0 h-full w-full object-cover select-none"
                    draggable="false"
                  />

                  <!-- Etiquetas -->
                  <span class="pointer-events-none absolute left-2 top-2 rounded bg-black/60 px-2 py-0.5 font-heading text-[10px] font-bold uppercase tracking-wider text-text">
                    Después
                  </span>
                  <span class="pointer-events-none absolute right-2 top-2 rounded bg-black/60 px-2 py-0.5 font-heading text-[10px] font-bold uppercase tracking-wider text-text">
                    Antes
                  </span>

                  <!-- Línea + manija -->
                  <div class="cmp-divisor pointer-events-none absolute inset-y-0" style="left:var(--pos);">
                    <div class="absolute inset-y-0 -ml-px w-0.5 bg-white/90"></div>
                    <div class="absolute top-1/2 left-0 flex h-9 w-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-white bg-black/50 backdrop-blur-sm">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 6l-4 6 4 6M15 6l4 6-4 6" />
                      </svg>
                    </div>
                  </div>

                  <!-- Control accesible (drag + teclado) -->
                  <input
                    type="range"
                    min="0"
                    max="100"
                    value="50"
                    step="0.1"
                    aria-label={`Comparar antes y después: ${t.etiqueta}`}
                    class="cmp-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
                  />
                </div>
              ) : t.despues ? (
                /* ── Solo resultado (con foto) ── */
                <img
                  src={t.despues}
                  alt={t.despuesAlt ?? t.etiqueta}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                /* ── Placeholder (sin foto todavía) ── */
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-linear-to-br from-surface-2 to-surface p-4">
                  <div class="rounded-full border border-white/20 bg-white/5 p-3">
                    <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-silver)" stroke-width="1.5">
                      <path d={camIcon} />
                      <path d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <p class="text-center text-[11px] uppercase tracking-widest text-text-dim font-heading">Próximamente</p>
                </div>
              )}

              <!-- Badge "Resultado" en tarjetas sin comparador -->
              {!tieneAntes && (
                <span class="pointer-events-none absolute right-2 top-2 rounded bg-black/60 px-2 py-0.5 font-heading text-[10px] font-bold uppercase tracking-wider text-silver">
                  Resultado
                </span>
              )}

              <!-- Overlay inferior con etiqueta -->
              <div
                class="pointer-events-none absolute inset-x-0 bottom-0 p-3"
                style="background: linear-gradient(to top, rgba(10,11,13,0.9), transparent);"
              >
                <span class="font-heading text-sm font-semibold uppercase text-text">
                  {t.etiqueta}
                </span>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Mensaje cuando un filtro no tiene resultados -->
      <p data-galeria-vacio hidden class="mt-10 text-center text-sm text-text-dim">
        No hay trabajos en esta categoría todavía. ¡Pronto subiremos más!
      </p>

      <!-- CTA inferior -->
      <div class="mt-12 text-center">
        <p class="mb-4 text-sm text-text-dim">
          ¿Quieres ser el próximo testimonio? Agenda tu cita hoy.
        </p>
        <a
          href={waLink("Hola ZIT'DCA RS, quiero agendar un servicio.")}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-whatsapp px-6 py-3 font-bold text-white transition-transform hover:scale-105 active:scale-95"
        >
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          Agendar ahora
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  /* El "antes" se recorta según --pos: se muestra desde --pos hacia la derecha */
  .cmp-antes {
    clip-path: inset(0 0 0 var(--pos));
  }
  /* Quitar apariencia nativa del range (se usa solo como zona de arrastre invisible) */
  .cmp-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 44px;
    height: 100%;
  }
  .cmp-range::-moz-range-thumb {
    width: 44px;
    height: 100%;
    border: 0;
    background: transparent;
  }
  .cmp-range:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }
</style>

<script>
  // ── Filtros de la galería ─────────────────────────────────────────────────
  const filtrosWrap = document.querySelector<HTMLElement>('[data-galeria-filtros]');
  const grid = document.querySelector<HTMLElement>('[data-galeria-grid]');
  const vacio = document.querySelector<HTMLElement>('[data-galeria-vacio]');
  const soloAntes = document.querySelector<HTMLInputElement>('[data-solo-antes]');

  if (filtrosWrap && grid) {
    const chips = Array.from(filtrosWrap.querySelectorAll<HTMLButtonElement>('[data-filtro]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.galeria-card'));
    let filtroActivo = 'todos';

    const aplicar = () => {
      const sa = soloAntes?.checked ?? false;
      let visibles = 0;
      cards.forEach((card) => {
        const cat = card.dataset.categoria ?? '';
        const tieneAntes = card.dataset.tieneAntes === 'true';
        const pasaCat = filtroActivo === 'todos' || cat === filtroActivo;
        const pasaAntes = !sa || tieneAntes;
        const mostrar = pasaCat && pasaAntes;
        card.hidden = !mostrar;
        if (mostrar) visibles++;
      });
      if (vacio) vacio.hidden = visibles > 0;
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        filtroActivo = chip.dataset.filtro ?? 'todos';
        chips.forEach((c) => {
          const on = c === chip;
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
          c.classList.toggle('bg-blue', on);
          c.classList.toggle('text-white', on);
          c.classList.toggle('border', !on);
          c.classList.toggle('border-white/15', !on);
          c.classList.toggle('text-text-dim', !on);
        });
        aplicar();
      });
    });

    soloAntes?.addEventListener('change', aplicar);
  }

  // ── Comparadores antes/después ────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('[data-comparador]').forEach((cmp) => {
    const range = cmp.querySelector<HTMLInputElement>('.cmp-range');
    if (!range) return;
    const update = () => cmp.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', update);
    update();
  });
</script>
