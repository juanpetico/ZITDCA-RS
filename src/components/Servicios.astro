---
import { servicios, waLink } from '../data';
import { Image } from 'astro:assets';

// Las cards con `imagen` definida en los datos se muestran en el grid enriquecido;
// el resto usa el grid de tarjetas con ícono.
const serviciosIcono = servicios.filter((s) => !s.imagen);
const serviciosImagen = servicios.filter((s) => s.imagen);
---

<section id="servicios" class="bg-bg py-20 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">

    <!-- Encabezado de sección -->
    <div class="mb-12 text-center">
      <p class="mb-2 font-heading text-xs font-semibold uppercase tracking-[0.25em] text-red">
        Lo que hacemos
      </p>
      <h2 class="font-heading text-3xl font-bold uppercase text-text sm:text-4xl lg:text-5xl">
        Nuestros Servicios
      </h2>
      <p class="mt-4 text-text-dim max-w-2xl mx-auto">
        Contamos con el equipo y la experiencia para resolver cualquier situación de tu vehículo,
        desde el mantenimiento preventivo hasta el tuning de alto rendimiento.
      </p>
    </div>

    <!-- Grid de tarjetas estándar (con ícono) -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {serviciosIcono.map((s) => (
        <article
          data-anim="card"
          class:list={[
            "glass-card group relative flex flex-col gap-4 rounded-xl border p-6 transition-all duration-300",
            "hover:-translate-y-1 hover:shadow-xl",
            s.destacado
              ? "border-blue/40 shadow-[0_0_20px_rgba(30,91,255,0.15)] hover:shadow-[0_0_30px_rgba(30,91,255,0.25)] bg-surface-2/60"
              : "border-white/10 hover:border-blue/20 bg-surface/60",
          ]}
          style="backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
        >
          <!-- Acento de color para tarjeta destacada -->
          {s.destacado && (
            <div
              class="absolute inset-x-0 top-0 h-0.5 rounded-t-xl"
              style="background: linear-gradient(to right, var(--color-blue), var(--color-red));"
              aria-hidden="true"
            ></div>
          )}

          <!-- Icono SVG -->
          <div class:list={[
            "flex h-12 w-12 items-center justify-center rounded-xl",
            s.destacado ? "bg-blue/10" : "bg-white/5",
          ]}>
            <svg
              aria-hidden="true"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="1.5"
              class:list={[
                "shrink-0",
                s.destacado ? "stroke-blue" : "stroke-silver",
              ]}
            >
              <path d={s.iconoPath} stroke="currentColor" fill="none" stroke-width="1.5"/>
            </svg>
          </div>

          <!-- Contenido textual -->
          <div class="flex flex-col gap-2 flex-1">
            <h3 class:list={[
              "font-heading text-base font-semibold uppercase leading-tight",
              s.destacado ? "text-blue" : "text-text",
            ]}>
              {s.titulo}
            </h3>
            <p class="text-sm text-text-dim leading-relaxed flex-1">
              {s.descripcion}
            </p>
          </div>

          <!-- Mini-CTA -->
          <a
            href={waLink(`Hola ZIT'DCA RS, vengo de su página y quiero cotizar: ${s.titulo}`)}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "mt-auto inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition-all duration-200",
              s.destacado
                ? "bg-blue/20 text-blue hover:bg-blue/30"
                : "bg-white/5 text-text-dim hover:bg-white/10 hover:text-text",
            ]}
          >
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Cotizar por WhatsApp
          </a>

        </article>
      ))}
    </div>

    <!-- ──────────────────────────────────────────────────────────── -->
    <!-- Cards con imagen (modelo visual enriquecido)               -->
    <!-- ──────────────────────────────────────────────────────────── -->
    {serviciosImagen.length > 0 && (
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {serviciosImagen.map((s) => (
          <article
            data-anim="card"
            class="group relative overflow-hidden rounded-2xl border border-white/10 bg-surface/60 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl"
            style="backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
          >
            <!-- Línea gradiente superior -->
            <div
              class="absolute inset-x-0 top-0 z-10 h-0.5 rounded-t-2xl"
              style="background: linear-gradient(to right, var(--color-blue), var(--color-red));"
              aria-hidden="true"
            ></div>

            <!-- Imagen hero (optimizada vía astro:assets → AVIF/WebP responsive) -->
            <div class="relative h-52 w-full overflow-hidden sm:h-60">
              <Image
                src={s.imagen!}
                alt={s.imagenAlt ?? s.titulo}
                widths={[400, 800]}
                sizes="(min-width: 640px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <!-- Gradiente overlay sobre la imagen -->
              <div
                class="absolute inset-0"
                style="background: linear-gradient(to bottom, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.65) 100%);"
                aria-hidden="true"
              ></div>
            </div>

            <!-- Contenido inferior -->
            <div class="flex flex-col gap-3 p-6">
              <div class="flex items-start gap-3">
                <!-- Ícono pequeño de apoyo -->
                <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue/10">
                  <svg
                    aria-hidden="true"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke-width="1.5"
                    class="stroke-blue shrink-0"
                  >
                    <path d={s.iconoPath} stroke="currentColor" fill="none" stroke-width="1.5"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="font-heading text-lg font-bold uppercase leading-tight text-text">
                    {s.titulo}
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-text-dim">
                    {s.descripcion}
                  </p>
                </div>
              </div>

              <!-- CTA -->
              <a
                href={waLink(`Hola ZIT'DCA RS, vengo de su página y quiero cotizar: ${s.titulo}`)}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-xl py-3 text-sm font-semibold text-white transition-all duration-200 hover:opacity-90 hover:shadow-lg active:scale-95"
                style="background: linear-gradient(135deg, var(--color-blue), #1040cc);"
              >
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Cotizar por WhatsApp
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

  </div>
</section>
