---
import { stats } from '../data/site';

// Extrae el número puro para el count-up; el prefijo/sufijo es decorativo
function parseStatValue(valor: string): { prefix: string; num: number; suffix: string } {
  // Ejemplos: "+500", "+10", "100%", "4.9★"
  const match = valor.match(/^([^0-9]*)(\d+(?:\.\d+)?)(.*)$/);
  if (!match) return { prefix: '', num: 0, suffix: valor };
  return {
    prefix: match[1] ?? '',
    num: parseFloat(match[2] ?? '0'),
    suffix: match[3] ?? '',
  };
}
---

<section class="bg-surface py-16 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-2 gap-6 sm:gap-8 lg:grid-cols-4">
      {stats.map((stat) => {
        const { prefix, num, suffix } = parseStatValue(stat.valor);
        return (
          <div class="flex flex-col items-center gap-2 text-center">
            <!-- Número animado con count-up -->
            <p class="font-heading text-4xl font-bold text-text sm:text-5xl" aria-label={stat.valor}>
              <span class="text-blue">{prefix}</span>
              <span
                data-count={num}
                data-count-decimals={num % 1 !== 0 ? "1" : "0"}
              >{num}</span>
              <span class="text-red">{suffix}</span>
            </p>
            <p class="text-sm font-medium text-text-dim uppercase tracking-wide font-heading">
              {stat.etiqueta}
            </p>
            <!-- Línea decorativa roja debajo -->
            <div class="mt-1 h-0.5 w-8 bg-red rounded-full" aria-hidden="true"></div>
          </div>
        );
      })}
    </div>
  </div>
</section>
