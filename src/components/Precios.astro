---
import { servicios, categoriasServicio, waLink } from '../data';

// Excluimos las versiones con imagen (-premium) para no duplicar servicios en la lista.
const serviciosPrecio = servicios.filter((s) => !s.imagen);

// Agrupamos por categoría, en el orden definido, omitiendo categorías vacías.
const grupos = categoriasServicio
  .map((cat) => ({
    ...cat,
    items: serviciosPrecio.filter((s) => s.categoria === cat.id),
  }))
  .filter((g) => g.items.length > 0);
---

<section id="precios" class="bg-surface-2 py-20 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl">

    <!-- Encabezado -->
    <div class="mb-12 text-center">
      <p class="mb-2 font-heading text-xs font-semibold uppercase tracking-[0.25em] text-red">
        Transparencia total
      </p>
      <h2 class="font-heading text-3xl font-bold uppercase text-text sm:text-4xl">
        Lista de Precios
      </h2>
      <p class="mt-4 text-text-dim max-w-xl mx-auto text-sm">
        Precios de referencia. El costo final depende del diagnóstico y el modelo del vehículo.
        Toca una categoría para ver sus precios.
      </p>
    </div>

    <!-- Acordeón de categorías -->
    <div class="flex flex-col gap-3">
      {grupos.map((g, i) => (
        <details
          data-anim="card"
          class="group overflow-hidden rounded-xl border border-white/10 bg-surface/60 [[open]]:border-blue/30"
          open={i === 0}
        >
          <!-- Cabecera de la categoría -->
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 transition-colors hover:bg-white/5 [&::-webkit-details-marker]:hidden"
          >
            <span class="flex items-center gap-3">
              <span class="font-heading text-base font-semibold uppercase tracking-wide text-text">
                {g.label}
              </span>
              <span class="rounded-full bg-white/10 px-2 py-0.5 text-xs font-medium text-text-dim">
                {g.items.length}
              </span>
            </span>
            <svg
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-text-dim transition-transform duration-300 group-open:rotate-180"
            >
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>

          <!-- Filas de precio -->
          <div class="border-t border-white/5">
            {g.items.map((s, j) => (
              <div
                class:list={[
                  'flex items-center justify-between gap-4 px-5 py-3.5',
                  j < g.items.length - 1 ? 'border-b border-white/5' : '',
                ]}
              >
                <span class:list={[
                  'flex items-center gap-2 text-sm',
                  s.destacado ? 'text-blue font-semibold' : 'text-text',
                ]}>
                  {s.titulo}
                  {s.destacado && (
                    <span class="inline-block rounded-full bg-blue/20 px-2 py-0.5 text-[10px] font-normal text-blue">
                      Estrella
                    </span>
                  )}
                </span>
                <span class:list={[
                  'whitespace-nowrap font-heading text-sm font-bold',
                  s.destacado ? 'text-gold' : 'text-silver',
                ]}>
                  {s.precioDesde}
                </span>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>

    <!-- Nota al pie -->
    <p class="mt-6 text-center text-xs text-text-dim">
      ¿No ves tu servicio o necesitas un precio exacto? Cotiza sin compromiso.
    </p>

    <!-- CTA principal -->
    <div class="mt-8 text-center">
      <a
        href={waLink("Hola ZIT'DCA RS, vengo de su página y quiero cotizar mi servicio.")}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 rounded-full bg-whatsapp px-8 py-4 font-bold text-white shadow-lg shadow-whatsapp/20 transition-transform hover:scale-105 active:scale-95"
        aria-label="Cotizar mi servicio por WhatsApp"
      >
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Cotizar mi servicio por WhatsApp
      </a>
    </div>

  </div>
</section>
