---
import { site, waLink } from '../data/site';
---

<section id="contacto" class="bg-surface-2 py-20 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">

    <!-- Encabezado -->
    <div class="mb-12 text-center">
      <p class="mb-2 font-heading text-xs font-semibold uppercase tracking-[0.25em] text-red">
        Visítanos
      </p>
      <h2 class="font-heading text-3xl font-bold uppercase text-text sm:text-4xl">
        Contacto y Ubicación
      </h2>
    </div>

    <!-- Grid: info + mapa -->
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12 items-start">

      <!-- Columna izquierda: dirección, horario, botones -->
      <div class="flex flex-col gap-8">

        <!-- Dirección -->
        <div class="flex items-start gap-4">
          <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue/10 border border-blue/20">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-blue)" stroke-width="1.5">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-sm font-bold uppercase text-text tracking-wide mb-1">Dirección</h3>
            <p class="text-text-dim text-sm leading-relaxed">
              {site.address}
            </p>
            <!-- TODO: actualizar dirección en site.ts -->
          </div>
        </div>

        <!-- Horario -->
        <div class="flex items-start gap-4">
          <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue/10 border border-blue/20">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-blue)" stroke-width="1.5">
              <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-sm font-bold uppercase text-text tracking-wide mb-2">Horario de atención</h3>
            <ul class="flex flex-col gap-1.5" role="list">
              {site.hours.map((h) => (
                <li class="flex items-center justify-between gap-6 text-sm">
                  <span class="text-text-dim">{h.d}</span>
                  <span class:list={[
                    "font-semibold",
                    h.h === "Cerrado" ? "text-red/70" : "text-silver",
                  ]}>
                    {h.h}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Teléfono -->
        <div class="flex items-start gap-4">
          <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue/10 border border-blue/20">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-blue)" stroke-width="1.5">
              <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-sm font-bold uppercase text-text tracking-wide mb-1">Teléfono</h3>
            <a
              href={`tel:${site.phone.replace(/\s/g, '')}`}
              class="text-sm text-text-dim hover:text-silver transition-colors"
            >
              {site.phone}
            </a>
          </div>
        </div>

        <!-- Botones de acción -->
        <div class="flex flex-col sm:flex-row gap-3 mt-2">
          <!-- Cómo llegar -->
          <a
            href={site.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3 font-semibold text-text-dim transition-all hover:border-white/40 hover:text-text hover:bg-white/10"
          >
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6-3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            Cómo llegar (Maps)
          </a>

          <!-- WhatsApp -->
          <a
            href={waLink("Hola ZIT'DCA RS, quiero conocer más información sobre su ubicación y servicios.")}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-whatsapp px-6 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105 active:scale-95"
          >
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
        </div>

      </div>

      <!-- Columna derecha: mapa embebido -->
      <div class="rounded-xl overflow-hidden border border-white/10 bg-surface min-h-[320px] lg:min-h-[400px] w-full relative">
        <iframe
          src={`https://maps.google.com/maps?q=${encodeURIComponent(site.address)}&t=&z=15&ie=UTF8&iwloc=&output=embed`}
          class="absolute inset-0 w-full h-full"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Ubicación de ${site.name} en Google Maps`}
        ></iframe>
      </div>

    </div>
  </div>
</section>
