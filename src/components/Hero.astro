---
import { Image } from 'astro:assets';
import heroImg from '../assets/brand/hero.jpg';
import { site, waLink } from '../data';
---

<section
  id="inicio"
  class="relative min-h-screen flex items-center overflow-hidden"
  aria-label="Hero principal"
>
  <!-- Imagen de fondo a pantalla completa -->
  <Image
    src={heroImg}
    alt="Taller ZIT'DCA RS — Performance automotriz"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover object-center"
    style="z-index: 0;"
    widths={[640, 1024, 1920]}
    sizes="100vw"
  />

  <!-- Overlay oscuro para legibilidad (más oscuro en móvil) -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to right, rgba(10,11,13,0.95) 0%, rgba(10,11,13,0.85) 50%, rgba(10,11,13,0.3) 100%); z-index: 1;"
    aria-hidden="true"
  ></div>

  <!-- Contenido alineado a la izquierda -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-24 pt-32 sm:pt-28 sm:px-6 lg:px-8">
    <div class="max-w-xl lg:max-w-2xl">

      <!-- Eyebrow -->
      <p
        class="mb-4 font-heading text-xs font-semibold uppercase tracking-[0.25em] text-red"
        data-anim="hero-eyebrow"
      >
        Taller Especializado
      </p>

      <!-- H1 -->
      <h1
        class="mb-5 font-heading font-bold uppercase leading-tight text-text"
        style="font-size: clamp(2rem, 8vw, 5.5rem); letter-spacing: 0.02em;"
        data-anim="hero-h1"
      >
        ZIT'DCA RS —<br class="hidden sm:block" />
        <span class="text-blue">Tu auto al</span><br class="hidden sm:block" />
        máximo rendimiento
      </h1>

      <!-- Subtítulo -->
      <p
        class="mb-8 text-lg text-text-dim sm:text-xl"
        data-anim="hero-sub"
      >
        Diagnóstico honesto, refacciones de calidad y garantía por escrito.<br class="hidden sm:block" />
        Servicio directo con el técnico.
      </p>

      <!-- Botones CTA -->
      <div class="flex flex-col gap-4 sm:flex-row sm:gap-4" data-anim="hero-ctas">
        <!-- Botón primario: WhatsApp -->
        <a
          href={waLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full bg-whatsapp px-8 py-3.5 font-bold text-white shadow-lg transition-transform hover:scale-105 active:scale-95"
          aria-label="Agendar cita por WhatsApp"
        >
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Agendar por WhatsApp
        </a>

        <!-- Botón ghost: Ver servicios -->
        <a
          href="#servicios"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full border border-white/30 px-8 py-3.5 font-medium text-text-dim backdrop-blur-sm transition-colors hover:border-white/60 hover:text-text"
        >
          Ver servicios
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

  <!-- Indicador de scroll (chevron animado) -->
  <div
    class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex-col items-center gap-1 hidden sm:flex"
    data-anim="hero-scroll"
    aria-hidden="true"
  >
    <span class="text-xs text-text-dim tracking-widest uppercase font-heading" style="font-size: 0.6rem;">Scroll</span>
    <svg
      class="animate-bounce"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="var(--color-text-dim)"
      stroke-width="2"
    >
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </div>

  <!-- Contenedor para parallax de la imagen de fondo -->
  <!-- data-hero-bg permite al script de animaciones aplicar parallax -->
  <div data-hero-bg style="display: none;"></div>
</section>
